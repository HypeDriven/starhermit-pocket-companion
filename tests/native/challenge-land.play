# Generated by tools/gen-plays.mjs: the Beat the Clock challenge on a phone held sideways (844 x 390, DPR 3)
# by finger: the setup with the challenge list, the room, the pause sheet with help and back, then the
# planned session to its results.
# viewport 844x390@3
until 600 Daily Challenge
frames 10
touch =Play
until 120 Choose a mode
frames 10
touch =Challenge
until 120 Expected length
frames 10
touch =Beat the Clock
frames 10
save challenge-setup
touch =Start
until 300 Objective
frames 30
save challenge-room
touch =Pause and menu
until 60 Leave session
frames 5
save challenge-pause
touch =Help #2
until 60 How to play
frames 10
save challenge-help
touch =Close
frames 10
touch =Resume
frames 10
save challenge-room
touch =Play
frames 3
frames 10
save challenge-play
touch =Feed
frames 3
touch =Wash
frames 3
touch =Rest
frames 3
touch =Feed
frames 3
touch =Play
frames 3
touch =Rest
frames 3
touch =Feed
frames 3
touch =Wash
frames 3
touch =Play
frames 3
touch =Rest
frames 3
touch =Feed
frames 3
touch =Wash
frames 3
touch =Play
frames 3
touch =Rest
frames 3
touch =Feed
frames 3
until 300 Results
expect Session complete
frames 10
save challenge-results
